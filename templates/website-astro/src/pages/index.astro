---
// Start page (NAV-06, AKT-01, AKT-11, DAT-01, WEB-10): lead with one primary action, last in its group; a short list
// that ends with a sentence. The English version is /en/, so DE / EN links both ways.
import Base from "../layouts/Base.astro";
import { strings } from "../strings.mjs";
const s = strings.de.pages.start;
const a = strings.de.pages.article;
---
<Base lang="de" title={s.title} ogId="start" self="/" other="/en/" view="start" primary>
  <section class="sb-section sb-page-lead" aria-labelledby="lead-h">
    <h1 class="sb-page-lead__title" id="lead-h">{s.title}</h1>
    <p class="sb-page-lead__text">{s.lead}</p>
    <div class="sb-section__actions">
      <a class="sb-secondary-action" href="/ueber/">{s.secondary}</a>
      <a class="sb-primary-action" href="/projekte/">{s.primary}</a>
    </div>
  </section>
  <section class="sb-section" aria-labelledby="recent-h">
    <h2 class="sb-section__title" id="recent-h">{s.recentTitle}</h2>
    <ul class="sb-list">
      <li class="sb-list-row">
        <div class="sb-list-row__main">
          <p class="sb-list-row__title"><a class="sb-list-row__link" href="/projekte/liste-als-csv/">{a.title}</a></p>
          <p class="sb-list-row__meta">{a.meta(a.readingMinutes)}<time datetime={a.date}>{a.dateText}</time></p>
        </div>
        <span class="sb-list-row__trail"><svg class="sb-icon" aria-hidden="true" focusable="false"><use href="#chevron-right"/></svg></span>
      </li>
    </ul>
    <p class="sb-list-end">{s.recentEnd}</p>
  </section>
</Base>
